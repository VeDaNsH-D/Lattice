{
  "manifest_version": 3,
  "name": "Bookmark Importer",
  "version": "1.0.0",
  "description": "Imports Chrome bookmarks to backend",
  "permissions": ["bookmarks"],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
