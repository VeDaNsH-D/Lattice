{
  "info": {
    "name": "ShelfLife Invite Email System Test",
    "description": "Complete workflow to test email invitations",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Create Project",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{JWT_TOKEN}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test Project for Email\"\n}"
        },
        "url": {
          "raw": "{{BASE_URL}}/api/projects",
          "host": [
            "{{BASE_URL}}"
          ],
          "path": [
            "api",
            "projects"
          ]
        },
        "description": "Create a new project. Save the response._id as PROJECT_ID in your environment."
      },
      "response": []
    },
    {
      "name": "02 - Create Role",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{JWT_TOKEN}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Editor\",\n  \"projectId\": \"{{PROJECT_ID}}\",\n  \"permissions\": \"restricted_access\"\n}"
        },
        "url": {
          "raw": "{{BASE_URL}}/api/roles",
          "host": [
            "{{BASE_URL}}"
          ],
          "path": [
            "api",
            "roles"
          ]
        },
        "description": "Create a role. Save the response.role._id as ROLE_ID in your environment."
      },
      "response": []
    },
    {
      "name": "03 - Send Invite (TEST EMAIL)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{JWT_TOKEN}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"projectId\": \"{{PROJECT_ID}}\",\n  \"roleId\": \"{{ROLE_ID}}\"\n}"
        },
        "url": {
          "raw": "{{BASE_URL}}/api/invites",
          "host": [
            "{{BASE_URL}}"
          ],
          "path": [
            "api",
            "invites"
          ]
        },
        "description": "Send an invitation. Email should be sent automatically. Check backend logs and email inbox."
      },
      "response": []
    },
    {
      "name": "04 - List Pending Invites (Verify Email Sent)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{JWT_TOKEN}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{BASE_URL}}/api/invites/project/{{PROJECT_ID}}",
          "host": [
            "{{BASE_URL}}"
          ],
          "path": [
            "api",
            "invites",
            "project",
            "{{PROJECT_ID}}"
          ]
        },
        "description": "View all pending invites for the project. Should show the invite you just sent."
      },
      "response": []
    },
    {
      "name": "05 - Accept Invite",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{JWT_TOKEN}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{BASE_URL}}/api/invites/{{INVITE_ID}}/accept",
          "host": [
            "{{BASE_URL}}"
          ],
          "path": [
            "api",
            "invites",
            "{{INVITE_ID}}",
            "accept"
          ]
        },
        "description": "Accept an invite using its ID. Must be logged in as the invitee."
      },
      "response": []
    },
    {
      "name": "06 - Decline/Revoke Invite",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{JWT_TOKEN}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{BASE_URL}}/api/invites/{{INVITE_ID}}",
          "host": [
            "{{BASE_URL}}"
          ],
          "path": [
            "api",
            "invites",
            "{{INVITE_ID}}"
          ]
        },
        "description": "Delete/decline an invite."
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "BASE_URL",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "JWT_TOKEN",
      "value": "",
      "type": "string"
    },
    {
      "key": "PROJECT_ID",
      "value": "",
      "type": "string"
    },
    {
      "key": "ROLE_ID",
      "value": "",
      "type": "string"
    },
    {
      "key": "INVITE_ID",
      "value": "",
      "type": "string"
    }
  ]
}
