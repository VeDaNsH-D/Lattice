# Server
PORT=8000
PUBLIC_BASE_URL=http://localhost:8000

# Database
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<db_name>?retryWrites=true&w=majority

# Auth
JWT_SECRET=replace_with_a_long_random_secret

# AI (OpenAI-compatible API; defaults in code support Groq endpoint)
GROQ_API_KEY=replace_with_your_api_key
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_CHAT_MODEL=llama-3.3-70b-versatile
AI_EMBEDDING_MODEL=text-embedding-3-small

# Collision detection thresholds
COLLISION_SIMILARITY_THRESHOLD=0.84
COLLISION_AI_SCORE_THRESHOLD=0.55

# TTS (falls back to AI key/base URL if left empty)
TTS_API_KEY=
TTS_BASE_URL=https://api.groq.com/openai/v1
TTS_MODEL=playai-tts
TTS_VOICE=alloy

# Daily Pulse scheduler
DAILY_PULSE_CRON=0 9 * * *
DAILY_PULSE_TIMEZONE=Asia/Kolkata
