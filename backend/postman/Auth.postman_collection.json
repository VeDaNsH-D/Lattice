{
    "info": {
        "_postman_id": "9e523d48-1a9a-4f92-8ba0-c34bf57818a8",
        "name": "SE Hack Auth",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Register",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"name\": \"Pallav\",\n  \"email\": \"pallav.test@example.com\",\n  \"password\": \"password123\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/auth/register",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "auth",
                        "register"
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('Register status is 201', function () {",
                            "    pm.response.to.have.status(201);",
                            "});",
                            "",
                            "const data = pm.response.json();",
                            "pm.test('Register returns token', function () {",
                            "    pm.expect(data.token).to.be.a('string');",
                            "});",
                            "",
                            "if (data && data.token) {",
                            "    pm.collectionVariables.set('token', data.token);",
                            "}"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Login",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"email\": \"pallav.test@example.com\",\n  \"password\": \"password123\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/auth/login",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "auth",
                        "login"
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('Login status is 200', function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "",
                            "const data = pm.response.json();",
                            "pm.test('Login returns token', function () {",
                            "    pm.expect(data.token).to.be.a('string');",
                            "});",
                            "",
                            "if (data && data.token) {",
                            "    pm.collectionVariables.set('token', data.token);",
                            "}"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Me (Protected)",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/auth/me",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "auth",
                        "me"
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('Me status is 200', function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "",
                            "const data = pm.response.json();",
                            "pm.test('Me returns user object', function () {",
                            "    pm.expect(data.user).to.be.an('object');",
                            "    pm.expect(data.user.email).to.exist;",
                            "});"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Me without token (should fail)",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/api/auth/me",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "auth",
                        "me"
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('Me without token status is 401', function () {",
                            "    pm.response.to.have.status(401);",
                            "});"
                        ]
                    }
                }
            ]
        }
    ],
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:8000"
        },
        {
            "key": "token",
            "value": ""
        }
    ]
}